  m_Script: {fileID: 11500000, guid: 8dd649da29b0dcd418972723952236a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BarkGameOver
  dialoguesGameOver:
  - character: 2
    dialogue: YOUR AGENCY ATTEMPTS TO STUDY WHAT CANNOT BE COMPREHENDED
    dialogueIndex: 0
  - character: 0
    dialogue: WE WILL REMOVE PARASITES LIKE YOU FROM ALL DIMENSIONS
    dialogueIndex: 0
  - character: 2
    dialogue: THERE IS NO ESCAPE
    dialogueIndex: 1
  - character: 2
    dialogue: I WILL KILL YOU EACH TIME YOU COME BACK. I WILL TEAR YOUR SOUL APART
    dialogueIndex: 2
  - character: 2
    dialogue: DO YOU FEEL IT? THE ENDLESS COLD?
    dialogueIndex: 3
  - character: 0
    dialogue: WHERE DID YOU TAKE ME?
    dialogueIndex: 3
  - character: 2
    dialogue: YOU TREAD LANDS THAT ARE NOT YOURS
    dialogueIndex: 4
  - character: 0
    dialogue: "WE FIGHT\u2026 TO CLEANSE REALITY OF THOSE WHO WISH TO CONSUME IT"
    dialogueIndex: 5
  - character: 2
    dialogue: WHAT AN ARROGANT MOTTO
    dialogueIndex: 5
  - character: 0
    dialogue: "SO\u2026 COLD\u2026 WHERE AM I?"
    dialogueIndex: 6
  - character: 0
    dialogue: "IT\u2019S SO DARK HERE\u2026 WHAT HAPPENED?"
    dialogueIndex: 7
  - character: 0
    dialogue: "THIS CAN\u2019T BE IT. I HAVE TO GO BACK"
    dialogueIndex: 8
  - character: 1
    dialogue: VECTOR? VECTOR?! VECTORRRRR!
    dialogueIndex: 9
  barkTextCharFirst: {fileID: 848168815}
  barkTextDialogueFirst: {fileID: 1025812608}
  barkTextCharSecond: {fileID: 2135079453}
  barkTextDialogueSecond: {fileID: 1883946280}
  delayBetweenCharacters: 0.1
  delayBetweenDialogues: 1
  delayBeforeCharactersVanish: 1.2
